# Full stack (BUILD_PLAN step 2): Postgres + Redis for threads, jobs, traces
# Local dev credentials only — production secrets live in the platform secret store
# and are injected as environment variables (see DECISIONS.md).
DATABASE_URL=postgres://sailor:sailor@localhost:5432/sailor
REDIS_URL=redis://localhost:6379

# --- Heyo Cloud connection (get a token from your namespace dashboard at app.heyo.computer)
HEYO_TOKEN=
HEYO_SERVER=https://admin.us5.heyo.work
# The namespace must exist on your Heyo account (the token is scoped to it).
HEYO_NAMESPACE=sailor
# VM image to boot. heyo/bun:latest ships git + bun on Debian.
# Sandbox image. artifact: pull a prebuilt rootfs from the store (fast, no
# build). dockerfile: a store Dockerfile manifest the host builds. git: the
# host clones + builds — for a private repo point HEYO_IMAGE_GIT_SECRET at an
# app-lb secret holding the git token (image/build.sh can publish an artifact
# instead, which skips per-deployment builds).
HEYO_IMAGE=heyo/bun:latest
HEYO_IMAGE_KIND=artifact
# git kind only:
HEYO_IMAGE_GIT_REPO=
HEYO_IMAGE_GIT_REF=main
HEYO_IMAGE_GIT_DOCKERFILE=image/Dockerfile
HEYO_IMAGE_GIT_SECRET=
HEYO_IMAGE_GIT_SECRET_KEY=git-token
# git/dockerfile kinds: rootfs size in MB for host-built images — the kernel's
# ROOT disk (distinct from HEYO_DISK_GB, which is the /workspace data disk).
# The default (~1 GiB) fills up on pip installs; 4096 for real repos.
HEYO_IMAGE_SIZE_MB=4096
# git kind only: the worker mints an installation token on the way into every
# run and upserts it into HEYO_IMAGE_GIT_SECRET, so host-side builds always see
# a fresh credential (installation tokens live ~1h). Set 0 if the stored
# secret is a long-lived PAT you manage yourself.
HEYO_BUILD_SECRET_REFRESH=
HEYO_SIZE_CLASS=small
HEYO_DISK_GB=4

# --- Sandbox backend selection (default heyo): "heyo" | "e2b" | "daytona"
# Daytona is wired but inactive until anchor-ai-sdk ships its adapter —
# see docs/daytona.md for the activation checklist.
SAILOR_SANDBOX=heyo
# --- E2B cloud sandboxes (SAILOR_SANDBOX=e2b): E2B boots *templates*, so
# E2B_TEMPLATE must point at a template built with image/build-e2b.mjs.
E2B_API_KEY=
E2B_TEMPLATE=base
E2B_USER=
E2B_TIMEOUT_MS=3600000
E2B_DOMAIN=
# --- Daytona cloud sandboxes (SAILOR_SANDBOX=daytona): Daytona boots
# *snapshots*, so DAYTONA_IMAGE must name one carrying the agent toolchain.
DAYTONA_API_KEY=
DAYTONA_IMAGE=sailor-toolchain:latest

# --- GitHub App (decision #42) — the only credential path; PAT is retired.
# Create one at github.com/settings/apps (step-by-step: docs/github-app.md).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Paste the .pem contents raw, or base64 them, or use \n escapes — auto-decoded.
GITHUB_APP_PRIVATE_KEY=
# User-to-server OAuth (Sign in with GitHub, decision #44)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# One secret for app-level webhooks (the App's Webhook section)
GITHUB_WEBHOOK_SECRET=
# Webhook service port + dashboard base URL (trace links in pull requests point here)
SAILOR_PORT=8787
SAILOR_PUBLIC_URL=http://localhost:5173
# Optional publication policy, not a conversation/phase gate. Default 0:
# unverified new PRs are drafts. Set 1 to withhold publication without passing tests.
SAILOR_REQUIRE_PASSING_TESTS=0

# --- Accounts (decision #44): sessions + dev affordances
# How long a login session lasts, in days (default 30)
SESSION_TTL_DAYS=
# DEV ONLY: skip auth entirely for UI iteration (never set in production)
DEV_AUTH_BYPASS=

# --- LLM access (OpenRouter or any OpenAI-compatible endpoint)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Optional: USD per million tokens — enables $ accounting (budgets, evals)
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=
# Optional: USD per million CACHED input tokens (prompt-cache reads).
# deepseek-v4.1-flash: 0.0016 (25x cheaper than input).
LLM_PRICE_CACHE_READ=
# Optional: run budget dials — per RUN: defaults 300 steps / 150M tokens / $5.
# The thread's own budget (threads.budget_max_usd, default $25) is the revival
# chain's stop, so the run cap must stay a fraction of it. Defaults assume
# deepseek-flash prices: on a pricier model dollars bind first — raise them
# deliberately. Overnight profile: 1200 steps / 400M tokens / $50 per run.
SAILOR_MAX_STEPS=
SAILOR_MAX_TOKENS=
SAILOR_MAX_USD=

# A bash command still running after this many seconds is detached from the
# turn; the worker sweep delivers its completion as the next inbox turn
# (never a cancel, never model polling). 0 disables. Default 120.
SAILOR_EXEC_BACKGROUND_AFTER_SECS=
