{
  "name": "coding-agent-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Issue-to-PR coding harness: label a GitHub issue, get a fix PR with tests and a full trace, running in an isolated Firecracker microVM.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w apps/harness --",
    "dev": "node scripts/dev.mjs",
    "harness": "npm run harness -w apps/harness --",
    "doctor": "npm run doctor -w apps/harness --",
    "migrate": "npm run migrate -w apps/harness --"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
