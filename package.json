{
  "name": "sailor",
  "version": "0.1.0",
  "private": true,
  "description": "Sailor — an engineering workspace for conversations, repository work, and explicit PR delivery with a full agent trace. Built on Anchor (anchor-ai-sdk).",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w apps/server --",
    "test:ui": "npm run test:ui -w apps/dashboard --",
    "dev": "node scripts/dev.mjs",
    "sailor": "npm run cli -w apps/server --",
    "doctor": "npm run doctor -w apps/server --",
    "serve": "npm run serve -w apps/server",
    "worker": "npm run worker:watch -w apps/server",
    "db:generate": "npm run db:generate -w apps/server",
    "migrate": "npm run migrate -w apps/server --",
    "secrets:local": "node scripts/seed-local-secrets.mjs",
    "build:contracts": "npm run build -w packages/contracts",
    "prebuild": "npm run build:contracts",
    "pretypecheck": "npm run build:contracts",
    "predev": "npm run build:contracts",
    "preserve": "npm run build:contracts",
    "preworker": "npm run build:contracts",
    "premigrate": "npm run build:contracts",
    "predoctor": "npm run build:contracts",
    "presailor": "npm run build:contracts",
    "pretest": "npm run build:contracts",
    "pretest:integration": "npm run build:contracts",
    "pretest:ui": "npm run build:contracts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
